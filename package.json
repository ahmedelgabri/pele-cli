{
	"name": "@ahmedelgabri/pele-cli",
	"version": "0.1.1",
	"description": "Command-line interface for Pele: validate diagrams and render them to themeable SVG.",
	"keywords": [
		"cli",
		"diagram",
		"mermaid",
		"pele",
		"svg"
	],
	"homepage": "https://github.com/ahmedelgabri/pele-cli#readme",
	"bugs": {
		"url": "https://github.com/ahmedelgabri/pele-cli/issues"
	},
	"license": "MIT",
	"author": "Ahmed El Gabri",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ahmedelgabri/pele-cli.git"
	},
	"bin": {
		"pele": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "node --test 'test/**/*.test.ts'",
		"test:e2e": "node --test --test-global-setup=e2e/global-setup.ts 'e2e/**/*.test.ts'",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test && pnpm run test:e2e",
		"prepublishOnly": "pnpm run check && pnpm run build"
	},
	"dependencies": {
		"pele": "1.6.0"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2004",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22.4"
	}
}
